{
  "name": "fog-of-war-tank-hunt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4847",
    "mp": "tsx scripts/mp-server.ts",
    "dev:mp": "concurrently -k -n vite,mp -c cyan,magenta \"npm run dev\" \"npm run mp\"",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4848",
    "eval:orders": "tsx scripts/eval-orders.ts",
    "test": "npm run eval:orders"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
